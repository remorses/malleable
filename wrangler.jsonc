{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovepack",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    { "binding": "jsCache", "id": "6b37928db4814bf2a05819634cb9845b" },
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "lovepack" }],
  // Public origin of this Worker, used in git remote urls. Override in .dev.vars for local dev.
  "vars": { "PUBLIC_URL": "https://remote-bundler.fumabase.com" },
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ProjectDO",
        "name": "PROJECT",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["Sandbox"],
      "new_sqlite_classes": ["BunContainer"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ProjectDO"],
    },
    {
      "tag": "v4",
      "deleted_classes": ["BunContainer"],
    },
  ],
  "routes": [
    {
      "zone_name": "fumabase.com",
      "custom_domain": true,
      "pattern": "remote-bundler.fumabase.com",
    },
  ],
  "rules": [
    // Tailwind stylesheets are imported as text
    { "type": "Text", "globs": ["**/*.css"], "fallthrough": false },
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
}
