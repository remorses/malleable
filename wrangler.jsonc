{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remote-bundler",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-10",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    {
      "zone_name": "fumabase.com",
      "custom_domain": true,
      "pattern": "remote-bundler.fumabase.com",
    },
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
}
