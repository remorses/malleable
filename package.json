{
  "name": "@malleable/ui",
  "version": "0.0.0",
  "description": "Typed client for Malleable UI: AI agents edit, build and commit versioned React UI projects",
  "keywords": [
    "malleable",
    "ui",
    "react",
    "ai",
    "agents",
    "bundler",
    "tailwind",
    "cloudflare-workers",
    "git",
    "live-preview"
  ],
  "license": "MIT",
  "homepage": "https://github.com/remorses/remote-bundler#readme",
  "bugs": {
    "url": "https://github.com/remorses/remote-bundler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remorses/remote-bundler.git",
    "directory": "."
  },
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./src": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "demo": "vite",
    "test": "pnpm vitest -u --run",
    "prettier": "prettier --write src",
    "deployment": "pnpm tsc && wrangler deploy --minify",
    "build": "tsc",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && pnpm build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@google/genai": "^1.14.0",
    "@rollup/browser": "4.63.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.2.1",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "ai": "^5.0.9",
    "eventemitter3": "^5.0.1",
    "importmap-vite-plugin": "^0.0.0",
    "isomorphic-git": "^1.42.4",
    "path-browserify": "^1.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.1.3",
    "spiceflow": "^1.17.9",
    "string-dedent": "^3.0.2",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.145.0",
    "zod": "^4.0.17",
    "zustand": "^5.0.7"
  }
}
