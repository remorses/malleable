{
  "name": "malleable-dashboard-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "FORCE_COLOR=1 vite dev",
    "build": "tsc && FORCE_COLOR=1 vite build",
    "typecheck": "tsc",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:prod": "echo \"D1 pre-migration timestamp: $(date +%s)\" && wrangler d1 migrations apply DB --remote",
    "deploy:prod": "pnpm db:migrate:prod && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.129",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@malleable/ui": "workspace:^",
    "ai": "^7.0.126",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "spiceflow": "1.26.0-rsc.18",
    "string-dedent": "^3.0.2",
    "ulid": "^3.0.2",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.145.0"
  }
}
